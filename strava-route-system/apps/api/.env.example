# 複製成 .env 後填值；.env 已被 .gitignore 排除，不要 commit
ENVIRONMENT=local
CORS_ORIGINS=["http://localhost:3000"]

# 不用 docker compose、直接跑 uvicorn 時才需要；compose 會自己覆蓋
DATABASE_URL=mysql+pymysql://routecast:routecast@127.0.0.1:3306/routecast?charset=utf8mb4

# firebase | fake（fake 只在非 production 可用，token 格式 fake:<uid>[:<email>]）
AUTH_PROVIDER=firebase
FIREBASE_PROJECT_ID=
# 與 web 的 FIREBASE_SERVICE_ACCOUNT_JSON 相同（單行 JSON 字串）；只驗 token 可只填 FIREBASE_PROJECT_ID
FIREBASE_SERVICE_ACCOUNT_JSON=

# production 必須 >= 32 字元，例如 `python -c "import secrets;print(secrets.token_urlsafe(48))"`
SESSION_JWT_SECRET=local-dev-only-replace-me-with-a-random-48-char-value
SESSION_TTL_SECONDS=604800

# local | s3
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./.data/objects
S3_BUCKET=routecast-gpx
S3_ENDPOINT_URL=
S3_REGION=ap-northeast-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

GPX_MAX_BYTES=10485760
GPX_MAX_ROUTES_PER_MEMBER=200
