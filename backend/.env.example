# SQLAlchemy 連線字串；本機 docker compose 的 MySQL 見 docker-compose.yml
DATABASE_URL=mysql+pymysql://velorder:velorder@localhost:3306/velorder?charset=utf8mb4

# Firebase 專案 ID（驗 ID token 用，不需要服務帳號金鑰）
FIREBASE_PROJECT_ID=

# 正式環境（HTTPS）必須為 true；本機 http 開發才設 false
SESSION_COOKIE_SECURE=false

# session 有效天數，每次通過驗證會滑動延長
SESSION_TTL_DAYS=7
